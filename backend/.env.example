# Postgres. DATABASE_URL es la conexión que usa la app (pooler en producción);
# DIRECT_URL es la conexión de sesión que Prisma usa para las migraciones.
DATABASE_URL=postgresql://app:app@localhost:5432/checkout?schema=public
DIRECT_URL=postgresql://app:app@localhost:5432/checkout?schema=public

# Puerto HTTP del backend
PORT=3000

# Origen permitido para CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# Pasarela de pago en modo sandbox. Llenar con las llaves de prueba entregadas
# para el reto; NUNCA usar llaves productivas. Ver README.
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_PRIVATE_KEY=
PAYMENT_GATEWAY_INTEGRITY_SECRET=

# Fee fijo agregado siempre a cada compra, en centavos
BASE_FEE_CENTS=500000
